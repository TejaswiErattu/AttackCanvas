ANTHROPIC_API_KEY=

GITHUB_PERSONAL_ACCESS_TOKEN=
ATTACKCANVAS_MODEL_PROFILE=dev

# Optional: analyse only these GitHub owners (comma-separated, e.g. acme,widgets-inc).
# Blank means every owner is allowed. See docs/security-design.md, "Responsible use".
ATTACKCANVAS_ALLOWED_OWNERS=

# Optional demo mode: with DEMO_FALLBACK=1, submitting GOLDEN_REPO_URL serves the saved
# fixtures/demo-analysis.json with no GitHub, Semgrep or model call. See README "Demo".
DEMO_FALLBACK=
GOLDEN_REPO_URL=
