rules_version = '2';

// Firestore security rules for the Cyber Study Plan tracker.
// Each signed-in user can read & write ONLY their own document under /users/{uid}.
// This is secure (no public access) and works with Google Sign-In.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
